```gitignore
# Dependencies
node_modules/

# Build outputs
build/
dist/
*.js.map

# Environment variables
.env
.env.local
*.env.*

# Logs
*.log

# Coverage reports
coverage/
htmlcov/
*.coverage

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Python specific
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.coverage

# Temporary files
*.tmp
*.temp

# OS generated files
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.mypy_cache/
.nyc_output/
coverage.xml

# Distribution / packaging
*.tar.gz
*.whl
*.egg-info/

# Node specific
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Compiled Binary files
*.exe
*.dll
*.so
*.a
*.o
*.obj
*.out

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```